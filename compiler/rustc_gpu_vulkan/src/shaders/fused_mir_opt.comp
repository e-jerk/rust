#version 450

layout(local_size_x = 256) in;

// Block configuration buffer (4 uints per block)
layout(set = 0, binding = 0) readonly buffer BlockConfigs {
    uint data[];
} configs;

// Packed effects buffer: 1 uint32 per statement
//
// This is an OVERLAY encoding: different analyses read different bit ranges
// from the SAME uint32. Multiple analyses can be active on one statement.
//
// Bit layout (overlay view):
//   [24-31]  [16-23]  [8-15]   [0-7]
//   reach    const    copy     dse
//   def_id   local    dst/src  kind
//            value    (or      (and
//                    local)     local)
//
// Per-analysis extraction:
//   DSE:        bits 0-7 (kind: 0=NOOP, 1=GEN, 2=KILL), bits 8-15 (local)
//   Copy prop:  bits 8-23 (dst<<8 | src, or 0xFFFF=NOOP)
//   Const prop: bits 16-31 (local<<8 | value, or 0xFFFF=NOOP)
//   Reach defs: bits 24-31 (def_id, or 0xFF=NOOP)
//
// Example: statement `x = 5` where x is local 3:
//   DSE:    KILL(3)      -> bits 0-7 = 2, bits 8-15 = 3
//   Copy:   NOOP         -> bits 8-23 = 0xFFFF
//   Const:  Assign(3, 5) -> bits 16-31 = (3<<8 | 5) = 0x0305
//   Reach:  def_id=7     -> bits 24-31 = 7
//   Full uint32: (7<<24) | (0x0305<<16) | (0xFFFF<<8) | (2 | (3<<8))
//              = 0x0703_05FF_0203
layout(set = 0, binding = 1) readonly buffer EffectsFused {
    uint data[];
} effects_fused;

// Entry states: interleaved per block
//   [dse(bitset_words) | copy(num_locals) | const(num_locals) | reach(bitset_words)]
layout(set = 0, binding = 2) buffer EntryStatesFused {
    uint data[];
} entry_states_fused;

// Exit states: same interleaving as entry
layout(set = 0, binding = 3) buffer ExitStatesFused {
    uint data[];
} exit_states_fused;

// Convergence flags: one uint per analysis
layout(set = 0, binding = 4) buffer Convergence {
    uint flags[4];
} convergence;

layout(push_constant) uniform PushConstants {
    uint num_blocks;
    uint num_locals;
    uint bitset_words;
    uint effects_stride;
} pc;

// Maximum sizes for per-thread state arrays
#define MAX_BITSET_WORDS 32   // 32 words = 1024 locals/defs
#define MAX_LOCALS 128        // 128 locals for copy/const propagation

// Per-block state stride: dse(32) + copy(128) + const(128) + reach(32) = 320
#define BLOCK_STATE_STRIDE (MAX_BITSET_WORDS + MAX_LOCALS + MAX_LOCALS + MAX_BITSET_WORDS)

// State encoding for non-bitset analyses:
//   0        = "no information" (local not constant / not a copy)
//   value+1  = "local holds this value" (allows value 0-65534)
// This encoding lets us distinguish "uninitialized" (0) from "constant 0" (1).

#define EFFECT_DSE_NOP  0
#define EFFECT_DSE_GEN  1
#define EFFECT_DSE_KILL 2

#define DSE_EFFECT(e)  ((e) & 0xFF)
#define DSE_LOCAL(e)   (((e) >> 8) & 0xFF)
#define COPY_FACT(e)   (((e) >> 8) & 0xFFFF)
#define CONST_FACT(e)  (((e) >> 16) & 0xFFFF)
#define REACH_DEF(e)   (((e) >> 24) & 0xFF)

#define COPY_NOOP  0xFFFF
#define CONST_NOOP 0xFFFF
#define REACH_NOOP 0xFF

// Dead Store Elimination: backward iteration, bitset operations
void transfer_dse(uint block_idx, uint stmt_count, uint max_bitset_words, inout uint dse_state[MAX_BITSET_WORDS]) {
    // Unsigned reverse iteration: stmt_count-- > 0u handles stmt_count=0 safely
    for (uint stmt_idx = stmt_count; stmt_idx-- > 0u; ) {
        uint effect = effects_fused.data[block_idx * pc.effects_stride + stmt_idx];
        uint kind = DSE_EFFECT(effect);

        if (kind == EFFECT_DSE_NOP) continue;

        uint local = DSE_LOCAL(effect);
        if (local >= max_bitset_words * 32) continue;

        uint word = local / 32;
        uint bit = local % 32;
        uint mask = 1u << bit;

        if (kind == EFFECT_DSE_GEN) {
            dse_state[word] |= mask;
        } else if (kind == EFFECT_DSE_KILL) {
            dse_state[word] &= ~mask;
        }
    }
}

// Copy Propagation: forward iteration, per-local array
void transfer_copy_prop(uint block_idx, uint stmt_count, uint max_locals, inout uint copy_state[MAX_LOCALS]) {
    for (uint stmt_idx = 0; stmt_idx < stmt_count; stmt_idx++) {
        uint effect = effects_fused.data[block_idx * pc.effects_stride + stmt_idx];
        uint fact = COPY_FACT(effect);

        if (fact == COPY_NOOP) continue;

        uint dst = (fact >> 8) & 0xFF;
        uint src = fact & 0xFF;

        if (dst < max_locals) {
            copy_state[dst] = src + 1; // +1 to distinguish from "no copy" (0)
        }
    }
}

// Constant Propagation: forward iteration, per-local array
void transfer_const_prop(uint block_idx, uint stmt_count, uint max_locals, inout uint const_state[MAX_LOCALS]) {
    for (uint stmt_idx = 0; stmt_idx < stmt_count; stmt_idx++) {
        uint effect = effects_fused.data[block_idx * pc.effects_stride + stmt_idx];
        uint fact = CONST_FACT(effect);

        if (fact == CONST_NOOP) continue;

        uint local = (fact >> 8) & 0xFF;
        uint value = fact & 0xFF;

        if (local < max_locals) {
            const_state[local] = value + 1; // +1 to distinguish from "not constant" (0)
        }
    }
}

// Reaching Definitions: forward iteration, bitset operations
void transfer_reaching_defs(uint block_idx, uint stmt_count, uint max_bitset_words, inout uint reach_state[MAX_BITSET_WORDS]) {
    for (uint stmt_idx = 0; stmt_idx < stmt_count; stmt_idx++) {
        uint effect = effects_fused.data[block_idx * pc.effects_stride + stmt_idx];
        uint def_id = REACH_DEF(effect);

        if (def_id == REACH_NOOP) continue;

        uint word = def_id / 32;
        uint bit = def_id % 32;

        if (word < max_bitset_words) {
            reach_state[word] |= (1u << bit);
        }
    }
}

void main() {
    uint block_idx = gl_GlobalInvocationID.x;
    if (block_idx >= pc.num_blocks) return;

    uint config_base = block_idx * 4;
    uint stmt_count = configs.data[config_base];

    // State layout per block (fixed max sizes):
    //   [dse(MAX_BITSET_WORDS) | copy(MAX_LOCALS) | const(MAX_LOCALS) | reach(MAX_BITSET_WORDS)]
    // NOTE on DSE direction: DSE is a backward analysis. The host-level fixed-point
    // loop handles this by swapping which physical buffer is passed as "entry" vs
    // "exit" each round. The shader always reads binding 2 and writes binding 3.
    uint block_base = block_idx * uint(BLOCK_STATE_STRIDE);
    uint dse_start = block_base;
    uint copy_start = block_base + uint(MAX_BITSET_WORDS);
    uint const_start = copy_start + uint(MAX_LOCALS);
    uint reach_start = const_start + uint(MAX_LOCALS);

    uint max_bitset_words = min(pc.bitset_words, uint(MAX_BITSET_WORDS));
    uint max_locals = min(pc.num_locals, uint(MAX_LOCALS));

    // Load all 4 entry states
    uint dse_state[MAX_BITSET_WORDS];
    for (uint w = 0; w < max_bitset_words; w++) {
        dse_state[w] = entry_states_fused.data[dse_start + w];
    }

    uint copy_state[MAX_LOCALS];
    for (uint i = 0; i < max_locals; i++) {
        copy_state[i] = entry_states_fused.data[copy_start + i];
    }

    uint const_state[MAX_LOCALS];
    for (uint i = 0; i < max_locals; i++) {
        const_state[i] = entry_states_fused.data[const_start + i];
    }

    uint reach_state[MAX_BITSET_WORDS];
    for (uint w = 0; w < max_bitset_words; w++) {
        reach_state[w] = entry_states_fused.data[reach_start + w];
    }

    // Call all 4 transfer functions
    transfer_dse(block_idx, stmt_count, max_bitset_words, dse_state);
    transfer_copy_prop(block_idx, stmt_count, max_locals, copy_state);
    transfer_const_prop(block_idx, stmt_count, max_locals, const_state);
    transfer_reaching_defs(block_idx, stmt_count, max_bitset_words, reach_state);

    // Write all 4 exit states and track per-analysis changes
    bool changed_dse = false;
    for (uint w = 0; w < max_bitset_words; w++) {
        uint old = exit_states_fused.data[dse_start + w];
        if (old != dse_state[w]) {
            exit_states_fused.data[dse_start + w] = dse_state[w];
            changed_dse = true;
        }
    }

    bool changed_copy = false;
    for (uint i = 0; i < max_locals; i++) {
        uint old = exit_states_fused.data[copy_start + i];
        if (old != copy_state[i]) {
            exit_states_fused.data[copy_start + i] = copy_state[i];
            changed_copy = true;
        }
    }

    bool changed_const = false;
    for (uint i = 0; i < max_locals; i++) {
        uint old = exit_states_fused.data[const_start + i];
        if (old != const_state[i]) {
            exit_states_fused.data[const_start + i] = const_state[i];
            changed_const = true;
        }
    }

    bool changed_reach = false;
    for (uint w = 0; w < max_bitset_words; w++) {
        uint old = exit_states_fused.data[reach_start + w];
        if (old != reach_state[w]) {
            exit_states_fused.data[reach_start + w] = reach_state[w];
            changed_reach = true;
        }
    }

    // Set convergence flags individually so the CPU can detect per-analysis convergence
    if (changed_dse) atomicOr(convergence.flags[0], 1u);
    if (changed_copy) atomicOr(convergence.flags[1], 1u);
    if (changed_const) atomicOr(convergence.flags[2], 1u);
    if (changed_reach) atomicOr(convergence.flags[3], 1u);
}
